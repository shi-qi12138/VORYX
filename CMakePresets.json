      "configurePreset": "linux-vulkan-software-release"
    },
    {
      "name": "linux-vulkan-x11-debug",
      "configurePreset": "linux-vulkan-x11-debug"
    },
    {
      "name": "linux-vulkan-x11-software-debug",
      "configurePreset": "linux-vulkan-x11-software-debug"
    },
    {
      "name": "linux-vulkan-wayland-debug",
      "configurePreset": "linux-vulkan-wayland-debug"
    },
    {
      "name": "linux-vulkan-wayland-software-debug",
