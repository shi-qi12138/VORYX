    {
      "name": "linux-opengl-debug",
      "configurePreset": "linux-opengl-debug"
    },
    {
      "name": "linux-opengl-software-debug",
      "configurePreset": "linux-opengl-software-debug"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 60
      }
    },
    {
      "name": "windows-debug",
      "inherits": "test-base",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "inherits": "test-base",
      "configurePreset": "windows-release"
    },
    {
      "name": "linux-debug",
      "inherits": "test-base",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "test-base",
      "configurePreset": "linux-release"
    },
    {
      "name": "windows-vulkan-debug",
      "inherits": "test-base",
      "configurePreset": "windows-vulkan-debug"
    },
    {
      "name": "windows-vulkan-release",
      "inherits": "test-base",
      "configurePreset": "windows-vulkan-release"
    },
    {
      "name": "linux-vulkan-debug",
      "inherits": "test-base",
      "configurePreset": "linux-vulkan-debug"
    },
    {
      "name": "linux-vulkan-release",
      "inherits": "test-base",
      "configurePreset": "linux-vulkan-release"
    },
    {
      "name": "linux-vulkan-software-debug",
      "inherits": "test-base",
      "configurePreset": "linux-vulkan-software-debug"
    },
    {
      "name": "linux-vulkan-software-release",
      "configurePreset": "linux-vulkan-software-release",
