@PACKAGE_INIT@

set(Voryx_PACKAGE_PREFIX "${PACKAGE_PREFIX_DIR}")
set(Voryx_WITH_NULL @VORYX_ENABLE_NULL@)
set(Voryx_WITH_OPENGL @VORYX_ENABLE_OPENGL@)
set(Voryx_WITH_VULKAN @VORYX_ENABLE_VULKAN@)
set(Voryx_WITH_WIN32_WSI @VORYX_ENABLE_WIN32_WSI@)
set(Voryx_WITH_X11 @VORYX_ENABLE_X11@)
set(Voryx_WITH_WAYLAND @VORYX_ENABLE_WAYLAND@)
set(Voryx_EXAMPLES_DIR "")
if(Voryx_WITH_NULL OR Voryx_WITH_OPENGL OR Voryx_WITH_WIN32_WSI OR Voryx_WITH_X11 OR Voryx_WITH_WAYLAND)
    set(Voryx_EXAMPLES_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/Voryx/examples")
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(Voryx_WITH_OPENGL AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_dependency(OpenGL COMPONENTS OpenGL EGL)
endif()
if(Voryx_WITH_VULKAN)
    find_dependency(Vulkan 1.2)
endif()
if(Voryx_WITH_X11)
    find_dependency(X11)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VoryxTargets.cmake")
set(Voryx_core_FOUND TRUE)
set(Voryx_rhi_api_FOUND TRUE)
set(Voryx_runtime_FOUND TRUE)
check_required_components(Voryx)
